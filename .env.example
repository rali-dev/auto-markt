# Supabase Postgres -- SESSION POOLER, Port 5432.
# NICHT der Transaction Pooler (6543): dort scheitern Migrationen und
# Prepared Statements. NICHT die Direct Connection: die ist IPv6-only.
# Zu finden in Supabase unter: Connect -> ORM -> Prisma
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORT>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

PORT=3000
