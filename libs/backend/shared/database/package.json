{
  "name": "@org/backend-shared-database",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "backend-shared-database",
    "tags": [
      "scope:shared",
      "platform:backend"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma7.config.ts"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "options": {
          "command": "npm run db:generate"
        }
      },
      "typecheck": {
        "dependsOn": [
          "prisma-generate"
        ]
      },
      "test": {
        "dependsOn": [
          "prisma-generate"
        ],
        "options": {
          "passWithNoTests": true
        }
      },
      "lint": {
        "dependsOn": [
          "prisma-generate"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "tslib": "^2.8.1"
  }
}
